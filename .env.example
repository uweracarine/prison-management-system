# Docker Environment Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_ENV=development
APP_PORT=8080

# Database
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=prison_management
MYSQL_USER=prison_user
MYSQL_PASSWORD=prison_pass

# Database port (host port)
DB_PORT=3307

# phpMyAdmin port
PMA_PORT=8081